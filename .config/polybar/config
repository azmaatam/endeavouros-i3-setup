[colors]
background = #99000000
foreground = #cdd6f4
alert = #f38ba8
green = #a6e3a1
yellow = #f9e2af
blue = #89b4fa
red = #f38ba8
cyan = #94e2d5
black = #000000
purple = #cba6f7
background-alt = #99000000
; #313244
disabled = #a89984

[bar/i3wmthemer_bar]
width = 100%
height = 30
radius = 0
fixed-center = true
dpi = 128
monitor = ${env:MONITOR:}

separator = |

; Menggunakan background flat tanpa blocky warna-warni
background = ${colors.background}
foreground = ${colors.foreground}

line-size = 3
line-color =

border-size = 0
border-color =

padding-left = 0
padding-right = 1

module-margin-left = 0
module-margin-right = 1

font-0 = "Source Code Pro Semibold:size=13;1"
font-1 = "Font Awesome 7 Free:style=Solid:size=13;1"
font-2 = "Font Awesome 7 Brands:style=Regular:size=13;1"
font-3 = "dejavusans:pixelsize=13"

modules-left = brightness alsa i3
modules-center = date
modules-right = battery memory cpu temperature eth

tray-position = right
tray-maxsize = 32
;tray-padding =

cursor-click = pointer
cursor-scroll = ns-resize

[module/i3]
type = internal/i3
format = <label-state> <label-mode>
index-sort = true
wrapping-scroll = false

label-mode-padding = 1
label-mode-foreground = ${colors.background}
label-mode-background = ${colors.yellow}

; Gaya minimalis: berlatar abu-abu gelap dengan garis bawah kuning saat aktif
label-focused = %index%
label-focused-background = ${colors.background-alt}
label-focused-foreground = ${colors.foreground}
label-focused-underline = ${colors.yellow}
label-focused-padding = 1

; Workspace tidak aktif menggunakan warna biru lembut
label-unfocused = %index%
label-unfocused-background = ${colors.background}
label-unfocused-foreground = ${colors.blue}
label-unfocused-padding = 1

label-visible = %index%
label-visible-background = ${colors.background}
label-visible-foreground = ${colors.blue}
label-visible-padding = 1

label-urgent = %index%
label-urgent-background = ${colors.alert}
label-urgent-padding = 1

[module/eth]
type = internal/network
interface-type = wireless
interval = 3.0

format-connected-padding = 2
format-connected-foreground = ${colors.blue}
format-connected-background = ${colors.background}
format-connected-prefix = " "
format-connected-prefix-foreground = ${colors.blue}
label-connected = %local_ip%

format-disconnected =

[module/date]
type = internal/date
interval = 1

date = " %b-%d-%Y"
date-alt =

time = %H:%M:%S
time-alt = %H:%M

format-foreground = ${colors.yellow}
format-background = ${colors.background-alt}
format-underline = ${colors.yellow}
format-padding = 1

label = %date%  %time%

[module/battery]
type = internal/battery

battery = BAT0
adapter = ADP0

full-at = 98
low-at = 20
poll-interval = 30

format-charging = %{T1} %{T-}<label-charging>
format-charging-foreground = ${colors.green}
format-discharging = <ramp-capacity> <label-discharging>
format-discharging-foreground = ${colors.cyan}
format-full = %{T1} %{T-} <label-full>
format-full-foreground = ${colors.green}
format-low = %{T1} %{T-} <label-low>
format-low-foreground = ${colors.red}

label-charging = %percentage%%
label-discharging = %percentage%%
label-full = %percentage%%
label-low = %percentage%%

ramp-capacity-0 = %{T1}%{T-}
ramp-capacity-1 = %{T1}%{T-}
ramp-capacity-2 = %{T1}%{T-}
ramp-capacity-3 = %{T1}%{T-}
ramp-capacity-4 = %{T1}%{T-}

[module/alsa]
type = internal/pulseaudio
interval = 1
format-volume =  <label-volume>
format-volume-foreground = ${colors.purple}
label-muted = %{T1}%{T-}
label-muted-foreground = ${colors.disabled}
label-volume = %percentage%%

[module/cpu]
type = internal/cpu
interval = 3
format = %{T1} %{T-} <label>
format-foreground = ${colors.yellow}
label = %percentage%%

[module/memory]
type = internal/memory
format = <label> <bar-used>
format-foreground = ${colors.purple}
label = RAM %gb_used%

; Bar indikator penggunaan RAM menyesuaikan warna Catppuccin
bar-used-indicator =
bar-used-width = 5
bar-used-foreground-0 = ${colors.green}
bar-used-foreground-1 = ${colors.blue}
bar-used-foreground-2 = ${colors.yellow}
bar-used-foreground-3 = ${colors.red}
bar-used-fill = ▐
bar-used-empty = ▐
bar-used-empty-foreground = ${colors.disabled}

[module/temperature]
type = internal/temperature
hwmon-path = /sys/class/hwmon/hwmon4/temp1_input
interval = 1
format = <label>
format-foreground = ${colors.red}
label =  %temperature-c%

[settings]
screenchange-reload = true

